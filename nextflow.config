// MethylForge — Nextflow configuration
// Two composable profile groups (mirrors CallForge):
//   execution : local | hpc_slurm
//   packaging : conda | mamba | docker | singularity | apptainer
// e.g.  -profile local,conda      (this Mac)
//       -profile hpc_slurm,singularity   (lab Ubuntu HPC)

manifest {
  name            = 'methylforge'
  author          = 'aduton1000'
  description     = 'Reproducible epigenome (DNA-methylation) analysis: short/long read, genome-wide/targeted, imprinting + episignature + DMR, clinical/research reports.'
  version         = '0.1.0'
  nextflowVersion = '>=23.10'
}

params {
  // ---- inputs ----
  samplesheet   = null          // CSV: sample,fastq_1,fastq_2,read_type,modbam,methylation,group
  outdir        = 'results'
  reference     = null          // genome FASTA (bisulfite index built/reused if present)
  targets       = null          // optional BED for targeted / capture methyl-seq
  read_type     = 'short'       // short | long   (per-sample column overrides)
  library       = 'bisulfite'   // bisulfite | emseq   (short-read conversion chemistry)
  // ---- analysis resources (consumed by the Python engine) ----
  imprint_panel = "${projectDir}/methylforge/resources/imprinted_dmrs.tsv"
  episign_ref   = null          // feature x sample beta TSV
  episign_labels= null          // sample,class TSV
  genes_bed     = null          // for DMR annotation
  run_dmr       = false         // cohort DMR (needs group column)
  report_modes  = 'clinical,research'
  // ---- compute caps ----
  max_cpus      = 16
  max_memory    = '120.GB'
  max_time      = '48.h'
}

process {
  cpus   = { Math.min(4  * task.attempt, params.max_cpus as int) }
  memory = { (8.GB * task.attempt) }
  time   = { (4.h  * task.attempt) }
  errorStrategy = { task.exitStatus in [137,139,140,143,247] ? 'retry' : 'finish' }
  maxRetries = 2
}

profiles {
  // ---- execution ----
  local     { process.executor = 'local' }
  hpc_slurm {
    process.executor = 'slurm'
    process.queue    = { task.time <= 4.h ? 'short' : 'long' }
    executor.queueSize = 100
  }
  // ---- packaging ----
  conda      { conda.enabled = true;  conda.useMamba = false }
  mamba      { conda.enabled = true;  conda.useMamba = true  }
  docker     { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)' }
  singularity{ singularity.enabled = true; singularity.autoMounts = true }
  apptainer  { apptainer.enabled  = true; apptainer.autoMounts  = true }
  // ---- test ----
  test       { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'

report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt"; overwrite = true }
