// Per-process labels -> conda env + resources
process {
  withLabel: qc_trim     { conda = "${projectDir}/env/align_short.yml"; cpus = 4;  memory = 8.GB }
  withLabel: align_short { conda = "${projectDir}/env/align_short.yml"; cpus = { Math.min(8, params.max_cpus as int) }; memory = 32.GB; time = 12.h }
  withLabel: align_long  { conda = "${projectDir}/env/align_long.yml";  cpus = { Math.min(8, params.max_cpus as int) }; memory = 32.GB; time = 12.h }
  withLabel: extract     { conda = "${projectDir}/env/extract.yml";     cpus = 4;  memory = 16.GB }
  withLabel: analysis    { conda = "${projectDir}/env/methylforge.yml"; cpus = 2;  memory = 8.GB }
  withLabel: report      { conda = "${projectDir}/env/methylforge.yml"; cpus = 1;  memory = 4.GB }
}
